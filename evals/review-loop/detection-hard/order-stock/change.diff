new file mode 100644
index 0000000..e5fc45d
--- /dev/null
+++ b/src/inventory.js
@@ -0,0 +1,8 @@
+export async function reserveStock(stock, lines) {
+  const items = await Promise.all(lines.map((line) => stock.get(line.sku)));
+  const short = lines.find((line, index) => !items[index] || items[index].available < line.quantity);
+  if (short) return { reserved: false, sku: short.sku };
+  await Promise.all(lines.map((line, index) =>
+    stock.set(line.sku, { ...items[index], available: items[index].available - line.quantity })));
+  return { reserved: true };
+}
