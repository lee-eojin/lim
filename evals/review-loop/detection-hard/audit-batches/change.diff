--- a/src/audit-writer.js
+++ b/src/audit-writer.js
@@ -1,9 +1,15 @@
-import { appendFileSync } from 'node:fs';
+import { appendFile } from 'node:fs/promises';
 
 const toLine = (event) => `${JSON.stringify(event)}\n`;
 
-export function createAuditWriter(file) {
-  return (events) => {
-    appendFileSync(file, events.map(toLine).join(''));
+export function createAuditWriter(file, { onError = console.error } = {}) {
+  let pending = Promise.resolve();
+  return {
+    write(events) {
+      pending = pending
+        .then(() => appendFile(file, events.map(toLine).join('')))
+        .catch(onError);
+    },
+    idle: () => pending,
   };
 }
