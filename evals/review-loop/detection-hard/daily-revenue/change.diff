@@ -0,0 +1,12 @@
+import { addDays, isoDate, startOfDay } from './dates.js';
+
+export function dailyRevenue(ledger, from, to) {
+  const rows = [];
+  for (let day = startOfDay(from); day < to; day = addDays(day, 1)) {
+    const entries = ledger.entriesBetween(day, addDays(day, 1));
+    const totalCents = entries.reduce((sum, entry) => sum + entry.amountCents, 0);
+    rows.push({ date: isoDate(day), totalCents });
+  }
+  const totalCents = rows.reduce((sum, row) => sum + row.totalCents, 0);
+  return { rows, totalCents };
+}
