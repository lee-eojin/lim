+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { ordersToCsv } from '../src/export-csv.js';
+import { formatMoney } from '../src/format.js';
+
+test('formatMoney shows dollars with two decimals', () => {
+  assert.equal(formatMoney(1999), '$19.99');
+  assert.equal(formatMoney(5), '$0.05');
+});
+
+test('ordersToCsv quotes cells that hold a comma or a quote', () => {
+  const csv = ordersToCsv([{
+    id: 'A-1',
+    createdAt: new Date('2026-03-05T10:00:00Z'),
+    customerName: 'Corner Shop, "North"',
+    items: [{ quantity: 2 }, { quantity: 1 }],
+    totalCents: 4500,
+  }]);
+  const [header, row] = csv.split('\n');
+  assert.equal(header, 'order,date,customer,items,total');
+  assert.ok(row.includes('"Corner Shop, ""North"""'));
+  assert.ok(row.endsWith(',3,$45.00'));
+});
