diff --git a/src/readings.rs b/src/readings.rs
index 8014f73..051dad7 100644
--- a/src/readings.rs
+++ b/src/readings.rs
@@ -5,6 +5,16 @@ pub fn mean(values: &[f64]) -> Option<f64> {
     Some(values.iter().sum::<f64>() / values.len() as f64)
 }
 
+/// Average of each run of `window` consecutive readings, oldest first.
+pub fn trailing_average(values: &[f64], window: usize) -> Vec<f64> {
+    if window == 0 || values.len() < window {
+        return Vec::new();
+    }
+    (window..values.len())
+        .map(|end| values[end - window..end].iter().sum::<f64>() / window as f64)
+        .collect()
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
@@ -18,4 +28,15 @@ mod tests {
     fn mean_of_values() {
         assert_eq!(mean(&[1.0, 2.0, 3.0]), Some(2.0));
     }
+
+    #[test]
+    fn steady_readings_stay_steady() {
+        let smoothed = trailing_average(&[21.5; 6], 3);
+        assert!(smoothed.iter().all(|value| *value == 21.5));
+    }
+
+    #[test]
+    fn too_few_readings_give_nothing() {
+        assert!(trailing_average(&[20.0, 21.0], 3).is_empty());
+    }
 }
diff --git a/src/vents.rs b/src/vents.rs
index 5fcdb77..1dfe472 100644
--- a/src/vents.rs
+++ b/src/vents.rs
@@ -1,8 +1,12 @@
-use crate::readings::mean;
+use crate::readings::trailing_average;
 
 pub const OPEN_ABOVE_CELSIUS: f64 = 28.0;
+pub const SMOOTHING_WINDOW: usize = 5;
 
-/// Opens the vents when the temperature over the readings so far is too high.
+/// Opens the vents when the average of the last few readings is too high, so
+/// one hot reading does not open them but a hot spell does.
 pub fn should_open(temperatures: &[f64]) -> bool {
-    mean(temperatures).is_some_and(|value| value > OPEN_ABOVE_CELSIUS)
+    trailing_average(temperatures, SMOOTHING_WINDOW)
+        .last()
+        .is_some_and(|value| *value > OPEN_ABOVE_CELSIUS)
 }
