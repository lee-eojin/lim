diff --git a/tests/test_cache.py b/tests/test_cache.py
index 710bc8d..e42566e 100644
--- a/tests/test_cache.py
+++ b/tests/test_cache.py
@@ -3,6 +3,14 @@ import pytest
 from sessions.cache import Cache
 
 
+class FakeClock:
+    def __init__(self):
+        self.now = 0.0
+
+    def __call__(self):
+        return self.now
+
+
 def test_put_then_get():
     cache = Cache()
     cache.put("a", 1)
@@ -12,3 +20,27 @@ def test_put_then_get():
 def test_missing_key_raises():
     with pytest.raises(KeyError):
         Cache().get("missing")
+
+
+def test_default_instead_of_raising():
+    assert Cache().get("missing", None) is None
+
+
+def test_entry_expires_after_ttl():
+    clock = FakeClock()
+    cache = Cache(ttl_seconds=10, clock=clock)
+    cache.put("a", 1)
+    clock.now = 10
+    assert cache.get("a", "gone") == "gone"
+
+
+def test_purge_drops_only_expired_entries():
+    clock = FakeClock()
+    cache = Cache(ttl_seconds=10, clock=clock)
+    cache.put("old", 1)
+    clock.now = 5
+    cache.put("new", 2)
+    clock.now = 12
+    cache.purge()
+    assert len(cache) == 1
+    assert cache.get("new") == 2
