-	return writeEntries(w, entries)
+// Write writes entries as CSV, compressed with gzip when options.Gzip is set,
+// and reports any error from w.
+func Write(w io.Writer, entries []Entry, options Options) error {
+	var err error
+	if options.Gzip {
+		compressed := gzip.NewWriter(w)
+		err := writeEntries(compressed, entries)
+		if err == nil {
+			err = compressed.Close()
+		}
+	} else {
+		err = writeEntries(w, entries)
+	}
+	return err
 }
