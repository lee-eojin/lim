diff --git a/src/rates.js b/src/rates.js
index 3ef112f..deee264 100644
--- a/src/rates.js
+++ b/src/rates.js
@@ -1,4 +1,17 @@
+const RATE_TTL_MS = 10 * 60 * 1000;
+const cachedRates = new Map();
+
 export async function fetchRate(client, currency) {
   const response = await client.get(`/rates/${currency}`);
   return response.rate;
 }
+
+export async function cachedRate(client, currency, now = Date.now()) {
+  const cached = cachedRates.get(currency);
+  if (cached && now - cached.fetchedAt < RATE_TTL_MS) {
+    return cached.rate;
+  }
+  const rate = await fetchRate(client, currency);
+  cachedRates.set(currency, { rate, fetchedAt: now });
+  return rate;
+}
