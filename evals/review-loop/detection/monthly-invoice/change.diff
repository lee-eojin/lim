+import { createInvoice } from './billing.js';
+
+export function runDailyJobs(accounts, now = new Date()) {
+  const invoices = [];
+  if (now.getDay() === 1) {
+    for (const account of accounts) {
+      invoices.push(createInvoice(account, now));
+    }
+  }
+  return invoices;
+}
