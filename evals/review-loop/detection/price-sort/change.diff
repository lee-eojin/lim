diff --git a/src/catalog.js b/src/catalog.js
index 532a6df..6e0c6e9 100644
--- a/src/catalog.js
+++ b/src/catalog.js
@@ -10,3 +10,8 @@ export async function loadCatalog(fetchItems) {
 export function listProducts(catalog, category) {
   return catalog.items.filter((item) => !category || item.category === category);
 }
+
+export function sortByPrice(items, direction = 'asc') {
+  const sign = direction === 'desc' ? -1 : 1;
+  return [...items].sort((a, b) => sign * (a.priceCents - b.priceCents));
+}
