@@ -0,0 +1,7 @@
+export function cheapestFirst(items) {
+  return items.sort((a, b) => a.priceCents - b.priceCents);
+}
+
+export function featuredDeals(catalog, count = 3) {
+  return cheapestFirst(catalog.items).slice(0, count);
+}
